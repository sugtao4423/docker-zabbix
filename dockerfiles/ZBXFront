FROM zabbix/zabbix-web-nginx-mysql:ubuntu-latest AS build
USER root
RUN apt-get update -qq && \
    apt-get install -y jq && \
    curl -sS 'https://fonts.google.com/download/list?family=Noto%20Sans%20JP' | \
        tail -n +2 | \
        jq -r '.manifest.fileRefs[] | select(.filename == "static/NotoSansJP-Regular.ttf") | .url' | \
        xargs curl -o /NotoSansJP-Regular.ttf

FROM zabbix/zabbix-web-nginx-mysql:ubuntu-latest
COPY --from=build /NotoSansJP-Regular.ttf /usr/share/zabbix/assets/fonts/NotoSansCJKjp-Regular.otf
